ascii\")\n","                predictions.append({\n","                    \"image_id\": rec[\"image_id\"],\n","                    \"category_id\": 1,   # competition category - NOT the Detectron2 0-index\n","                    \"segmentation\": {\"size\": rle[\"size\"], \"counts\": rle[\"counts\"]},\n","                    \"score\": float(scores[i]),\n","                })\n","    return predictions\n","\n","test_predictions = run_inference_on_test(test_records, eval_model, final_combo[\"bands\"], BAND_STATS,\n","                                         SCORE_THRESH, MAX_DETS_PER_IMAGE)\n","print(f\"Generated {len(test_predictions)} predictions across {len(test_records)} test images.\")\n","print(f\"(SCORE_THRESH={SCORE_THRESH}, MAX_DETS_PER_IMAGE={MAX_DETS_PER_IMAGE})\")"]},{"cell_type":"code","execution_count":28,"id":"64625fa7","metadata":{"execution":{"iopub.execute_input":"2026-09-28T15:11:36.93622Z","iopub.status.busy":"2026-09-28T15:11:36.935892Z","iopub.status.idle":"2026-09-28T15:11:36.946314Z","shell.execute_reply":"2026-09-28T15:11:36.945235Z"},"papermill":{"duration":0.353252,"end_time":"2026-09-28T15:11:36.948018+00:00","exception":false,"start_time":"2026-09-28T15:11:36.594766+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["tools/coco_utils.py not found - writing submission JSON directly.\n","Submission written to:\n","/kaggle/working/geoai_arctic_multiband_d2_r101/submission/submission_combo03_green_nir_relative_elevation.json\n"]}],"source":["os.makedirs(SUBMISSION_DIR, exist_ok=True)\n","SUBMISSION_PATH = os.path.join(SUBMISSION_DIR, f\"submission_combo{final_combo['id']:02d}_{final_combo['name']}.json\")\n","COCO_UTILS_PATH = \"tools/coco_utils.py\"\n","\n","if os.path.exists(COCO_UTILS_PATH):\n","    import sys\n","    sys.path.insert(0, os.path.dirname(COCO_UTILS_PATH) or \".\")\n","    import coco_utils\n","    print(\"tools/coco_utils.py found - check its function names and call the appropr