  state = ckpt[\"model\"] if isinstance(ckpt, dict) and \"model\" in ckpt else ckpt\n","    torch.save({\"model\": state}, best_weights_path)\n","    del ckpt, state\n","\n","    removed = 0\n","    for f in os.listdir(exp_dir):\n","        if re.fullmatch(r\"model_(\\d+|final)\\.pth\", f):\n","            os.remove(os.path.join(exp_dir, f))\n","            removed += 1\n","    print(f\"Best weights saved to: {best_weights_path}  (removed {removed} periodic/final checkpoints)\")\n","    return best_weights_path"]},{"cell_type":"code","execution_count":16,"id":"d206551d","metadata":{"execution":{"iopub.execute_input":"2026-09-28T11:13:14.266408Z","iopub.status.busy":"2026-09-28T11:13:14.265933Z","iopub.status.idle":"2026-09-28T11:13:14.272206Z","shell.execute_reply":"2026-09-28T11:13:14.271637Z"},"papermill":{"duration":0.013287,"end_time":"2026-09-28T11:13:14.273658+00:00","exception":false,"start_time":"2026-09-28T11:13:14.260371+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def load_best_checkpoint(output_dir, metrics_path=None):\n","    \"\"\"Pick the checkpoint with the highest validation segm/AP logged during training (per-experiment folder).\"\"\"\n","    if metrics_path is None:\n","        metrics_path = os.path.join(output_dir, \"metrics.json\")\n","    with open(metrics_path, \"r\") as f:\n","        lines = [json.loads(l) for l in f if l.strip()]\n","\n","    ap_entries = [l for l in lines if \"segm/AP\" in l and \"iteration\" in l]\n","    if not ap_entries:\n","        raise RuntimeError(f\"No 'segm/AP' entries found in {metrics_path}\")\n","\n","    best_entry = max(ap_entries, key=lambda l: l[\"segm/AP\"])\n","    best_iter = best_entry[\"iteration\"]\n","    best_ap = best_entry[\"segm/AP\"]\n","\n","    candidate = os.path.join(output_dir, f\"model_{best_iter:07d}.pth\")\n","    if not os.path.exists(candidate):\n","        available = sorted(\n","            int(m.group(1)) for m in (re.fullmatch(r\"model_(\\d+)\\.pth\", f) for f in os.listdir(output_dir)) if m\n","        )\n","        closest = min(available, key=lambda x: abs(x - best_iter))\n","        candidate = os.path.join(output_dir, f\"model_{closest:07d}.pth\")\n","        print(f\"Exact checkpoint for iter {best_iter} not found - using closest available: {candidate}\")\n","\n","    return candidate, best_ap, best_iter"]},{"cell_type":"code","execution_count":17,"id":"a1130baa","metadata":{"execution":{"iopub.execute_input":"2026-09-28T11:13:14.284768Z","iopub.status.busy":"2026-09-28T11:13:14.284525Z","iopub.status.idle":"2026-09-28T11:13:14.294626Z","shell.execute_reply":"2026-09-28T11:13:14.294022Z"},"papermill":{"duration":0.017333,"end_time":"2026-09-28T11:13:14.295915+00:00","exception":false,"start_time":"2026-09-28T11:13:14.278582+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# ============================================================\n","# EVALUATION MODEL + MASK-IoU METRICS (definitions only; the loop cell runs them)\n","# ============================================================\n","EVAL_SCORE_THRESH = 0.50   # aligned to the competition AP50 criterion, as in the original notebook\n","\n","def load_eval_model(cfg, weights_path):\n","    \"\"\"Build the 3-channel model in eval() mode with the 50% confidence threshold and load the given weights.\"\"\"\n","    eval_cfg = cfg.clone()\n","    eval_cfg.MODEL.WEIGHTS = weights_path\n","    eval_cfg.MODEL.ROI_HEADS.SCORE_THRESH_TEST = EVAL_SCORE_THRESH\n","    model = build_model(eval_cfg)\n","    model.eval()\n","    DetectionCheckpointer(model).load(weights_path)\n","    return model, eval_cfg\n","\n","\n","def calculate_iou(mask1, mask2):\n","    union = np.logical_or(mask1, mask2).sum()\n","    return np.logical_and(mask1, mask2).sum() / union if union > 0 else 0.0\n","\n","def evaluate_mask_iou(dataset_name, prediction_dir):\n","    pred_file = os.path.join(prediction_dir, \"coco_instances_results.json\")\n","    if os.path.exists(pred_file):\n","        with open(pred_file, \"r\") as f:\n","            predictions = json.load(f)\n","    else:                                   # evaluator writes nothing when there are zero detections\n","        predictions = []\n","\n","    pred_by_image = {}\n","    for p in predictions:\n","        pred_by_image.setdefault(p[\"image_id\"], []).append(p)\n","\n","    dataset = DatasetCatalog.get(dataset_name)\n","    all_ious = []\n","    total_gt = 0\n","\n","    for record in dataset:\n","        h, w = record[\"height\"], record[\"width\"]\n","\n","        # Decode Ground Truth Masks\n","        gt_masks = []\n","        for ann in record[\"annotations\"]:\n","            seg = ann[\"segmentation\"]\n","            rle = mask_utils.merge(mask_utils.frPyObjects(seg, h, w)) if isinstance(seg, list) else seg\n","            gt_masks.append(mask_utils.decode(rle).astype(bool))\n","\n","        # Decode Predicted Masks\n","        pred_masks = []\n","        for pred in pred_by_image.get(record[\"image_id\"], []):\n","            if \"segmentation\" in pred:\n","                pm = mask_utils.decode(pred[\"segmentation\"])\n","                pred_masks.append((pm[:, :, 0] if pm.ndim == 3 else pm).astype(bool))\n","\n","        total_gt += len(gt_masks)\n","\n","        # Greedy Matching (a missed GT contributes IoU = 0.0)\n","        used_preds = set()\n","        for gt in gt_masks:\n","            best_iou, best_idx = 0.0, -1\n","            for idx, pred in enumerate(pred_masks):\n","                if idx in used_preds: continue\n","                iou = calculate_iou(gt, pred)\n","                if iou > best_iou:\n","                    best_iou, best_idx = iou, idx\n","\n","            if best_idx != -1:\n","                used_preds.add(best_idx)\n","            all_ious.append(best_iou)\n","\n","    all_ious = np.array(all_ious, dtype=np.float32)\n","    return {\n","        \"Images\": int(len(dataset)),\n","        \"GT Instances\": int(total_gt),\n","        \"Mean IoU\": float(all_ious.mean()),\n","        \"Median IoU\": float(np.median(all_ious)),\n","        \"IoU >= 0.25 (%)\": float((all_ious >= 0.25).mean() * 100),\n","        \"IoU >= 0.50 (%)\": float((all_ious >= 0.50).mean() * 100),\n","        \"IoU >= 0.75 (%)\": float((all_ious >= 0.75).mean() * 100),\n","    }"]},{"cell_type":"code","execution_count":18,"id":"cb3d0c49","metadata":{"execution":{"iopub.execute_input":"2026-09-28T11:13:14.307238Z","iopub.status.busy":"2026-09-28T11:13:14.306785Z","iopub.status.idle":"2026-09-28T11:13:14.311481Z","shell.execute_reply":"2026-09-28T11:13:14.310797Z"},"papermill":{"duration":0.011821,"end_time":"2026-09-28T11:13:14.312885+00:00","exception":false,"start_time":"2026-09-28T11:13:14.301064+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["COCO_KEYS = (\"AP\", \"AP50\", \"AP75\", \"APs\", \"APm\", \"APl\")\n","\n","def coco_metrics_for_split(model, cfg, trainer_cls, dataset_name, out_dir):\n","    \"\"\"COCO segmentation metrics (weights frozen) for one split. Also writes coco_instances_results.json into out_dir.\"\"\"\n","    evaluator = COCOEvaluator(dataset_name, tasks=(\"segm\",), output_dir=out_dir)\n","    loader = trainer_cls.build_test_loader(cfg, dataset_name)\n","    results = inference_on_dataset(model, loader, evaluator)\n","    segm = results.get(\"segm\") if results else None\n","    if not segm:                            # no detections at all -> keep the run alive, record NaN\n","        return {k: float(\"nan\") for k in COCO_KEYS}\n","    return {k: float(segm[k]) for k in COCO_KEYS}"]},{"cell_type":"code","execution_count":19,"id":"402473ab","metadata":{"execution":{"iopub.execute_input":"2026-09-28T11:13:14.324229Z","iopub.status.busy":"2026-09-28T11:13:14.323888Z","iopub.status.idle":"2026-09-28T11:13:14.331158Z","shell.execute_reply":"2026-09-28T11:13:14.330593Z"},"papermill":{"duration":0.014776,"end_time":"2026-09-28T11:13:14.332691+00:00","exception":false,"start_time":"2026-09-