_for_split(model, eval_cfg, TrainerCls, ds_name, out_dir)\n","        iou_m = evaluate_mask_iou(ds_name, out_dir)\n","        result[split] = {\"coco\": coco_m, \"iou\": iou_m}\n","        print_coco_metrics(f\"{split.upper()}-SET METRICS (best checkpoint, weights frozen)\", coco_m)\n","    print_iou_table(result[\"train\"][\"iou\"], result[\"val\"][\"iou\"])\n","\n","    with open(os.path.join(exp_dir, \"results.json\"), \"w\") as f:\n","        json.dump(result, f, indent=2)\n","\n","    del model\n","    gc.collect()\n","    torch.cuda.empty_cache()\n","    return result\n","\n","\n","# ============================================================\n","# THE 20-COMBINATION EXPERIMENT LOOP (sequential, 1 -> 20)\n","# ============================================================\n","failed = []\n","for combo in COMBOS:\n","    banner = f\"[{combo['id']:02d}/20] {' + '.join(combo['bands'])}\" + (f\"   ({combo['alias']})\" if combo[\"alias\"] else \"\")\n","    print(\"\\n\" + \"=\" * 100 + \"\\n\" + banner + \"\\n\" + \"=\" * 100)\n","\n","    if RESUME_COMPLETED and os.path.exists(os.path.join(combo[\"dir\"], \"results.json\")):\n","        print(\"results.json already exists -> skipping (set RESUME_COMPLETED = False to retrain).\")\n","        continue\n","\n","    t0 = time.time()\n","    try:\n","        res = run_experiment(combo)\n","        print(f\"Finished combo {combo['id']:02d} in {(time.time() - t0) / 60:.1f} min | \"\n","              f\"val AP {res['val']['coco']['AP']:.2f} | val mean IoU {res['val']['iou']['Mean IoU']:.3f}\")\n","    except Exception:\n","        failed.append(combo[\"id\"])\n","        print(f\"!!! Combination {combo['id']:02d} FAILED:\")\n","        traceback.print_exc()\n","        gc.collect()\n","        torch.cuda.empty_cache()\n","\n","ALL_RESULTS = load_all_results()\n","print(f\"\\nCompleted combinations: {len(ALL_RESULTS)}/20\" + (f\" | FAILED: {failed}\" if failed else \"\"))"]},{"cell_type":"code","execution_count":25,"id":"c