335","metadata":{"execution":{"iopub.execute_input":"2026-09-28T11:12:59.282963Z","iopub.status.busy":"2026-09-28T11:12:59.282516Z","iopub.status.idle":"2026-09-28T11:12:59.301606Z","shell.execute_reply":"2026-09-28T11:12:59.300547Z"},"papermill":{"duration":0.026844,"end_time":"2026-09-28T11:12:59.303084+00:00","exception":false,"start_time":"2026-09-28T11:12:59.27624+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":[" 1. red + nir + relative_elevation   [V+S+H]\n"," 2. red + ndwi + relative_elevation\n"," 3. green + nir + relative_elevation\n"," 4. green + ndvi + relative_elevation\n"," 5. blue + nir + relative_elevation\n"," 6. blue + ndvi + relative_elevation\n"," 7. blue + ndwi + relative_elevation\n"," 8. red + nir + shaded_relief   [V+S+G]\n"," 9. red + ndwi + shaded_relief\n","10. green + nir + shaded_relief\n","11. green + ndvi + shaded_relief\n","12. blue + nir + shaded_relief\n","13. blue + ndvi + shaded_relief\n","14. blue + ndwi + shaded_relief\n","15. red + relative_elevation + shaded_relief   [V+H+G]\n","16. green + relative_elevation + shaded_relief\n","17. blue + relative_elevation + shaded_relief\n","18. nir + relative_elevation + shaded_relief   [S+H+G]\n","19. ndvi + relative_elevation + shaded_relief\n","20. ndwi + relative_elevation + shaded_relief\n"]}],"source":["# ============================================================\n","# 8-BAND LAYOUT, THE 20 REQUIRED 3-BAND COMBINATIONS, AND THE BAND LOADER\n","# ============================================================\n","# data[\"image\"] in every NPZ is H x W x 8. Bands 0-2 are red/green/blue (as in the RGB baseline).\n","# ASSUMPTION: bands 3-7 are stored in the order below. NEW CELL 9A prints per-band statistics so you\n","# can confirm it; if your files use another order, edit only this list.\n","BAND_ORDER = [\"red\", \"green\", \"blue\", \"nir\", \"ndvi\", \"ndwi\", \"relative_elevation\", \"shaded_relief\"]\n","BAND_INDEX = {name: i for i, name in enumerate(BAND_ORDER)}\n","SHORT_NAME = {\"red\": \"red\", \"green\": \"green\", \"blue\": \"blue\", \"nir\": \"nir\", \"ndvi\": \"ndvi\",\n","              \"ndwi\": \"ndwi\", \"relative_elevation\": \"relElev\", \"shaded_relief\": \"shRelief\"}\n","\n","# (id, optional V/S/H/G alias, bands in the exact channel order fed to the 3-channel model)\n","_COMBO_SPECS = [\n","    (1,  \"V+S+H\", (\"red\",   \"nir\",  \"relative_elevation\")),\n","    (2,  None,    (\"red\",   \"ndwi\", \"relative_elevation\")),\n","    (3,  None,    (\"green\", \"nir\",  \"relative_elevation\")),\n","    (4,  None,    (\"green\", \"ndvi\", \"relative_elevation\")),\n","    (5,  None,    (\"blue\",  \"nir\",  \"relative_elevation\")),\n","    (6,  None,    (\"blue\",  \"ndvi\", \"relative_elevation\")),\n","    (7,  None,    (\"blue\",  \"ndwi\", \"relative_elevation\")),\n","    (8,  \"V+S+G\", (\"red\",   \"nir\",  \"shaded_relief\")),\n","    (9,  None,    (\"red\",   \"ndwi\", \"shaded_relief\")),\n","    (10, None,    (\"green\", \"nir\",  \"shaded_relief\")),\n","    (11, None,    (\"green\", \"ndvi\", \"shaded_relief\")),\n","    (12, None,    (\"blue\",  \"nir\",  \"shaded_relief\")),\n","    (13, None,    (\"blue\",  \"ndvi\", \"shaded_relief\")),\n","    (14, None,    (\"blue\",  \"ndwi\", \"shaded_relief\")),\n","    (15, \"V+H+G\", (\"red\",   \"relative_elevation\", \"shaded_relief\")),\n","    (16, None,    (\"green\", \"relative_elevation\", \"shaded_relief\")),\n","    (17, None,    (\"blue\",  \"relative_elevation\", \"shaded_relief\")),\n","    (18, \"S+H+G\", (\"nir\",   \"relative_elevation\", \"shaded_relief\")),\n","    (19, None,    (\"ndvi\",  \"relative_elevation\", \"shaded_relief\")),\n","    (20, None,    (\"ndwi\",  \"relative_elevation\", \"shaded_relief\")),\n","]\n","\n","COMBOS = []\n","for _cid, _alias, _bands in _COMBO_SPECS:\n","    assert len(_bands) == 3 and all(b in BAND_INDEX for b in _bands), (_cid, _bands)\n","    _name = \"_\".join(_bands)\n","    COMBOS.append({\n","        \"id\": _cid,\n","        \"alias\": _alias,\n","        \"bands\": tuple(_bands),\n","        \"name\": _name,\n","        \"label\": f\"{_cid:02d} \" + \"+\".join(SHORT_NAME[b] for b in _bands),\n","        \"dir\": os.path.join(EXPERIMENTS_DIR, f\"combo_{_cid:02d}_{_name}\"),   # isolated output folder\n","    })\n","assert [c[\"id\"] for c in COMBOS] == list(range(1, 21))\n","assert len({c[\"bands\"] for c in COMBOS}) == 20, \"combinations must be unique\"\n","\n","for c in COMBOS:\n","    print(f\"{c['id']:>2}. {' + '.join(c['bands'])}\" + (f\"   [{c['alias']}]\" if c[\"alias\"] else \"\"))\n","\n","\n","# ------------------------------------------------------------\n","# Loading helpers\n","# ------------------------------------------------------------\n","def read_npz_image(npz_path):\n","    with np.load(npz_path) as data:\n","        img = data[\"image\"]\n","    if img.ndim != 3 or img.shape[2] != len(BAND_ORDER):\n","        raise ValueError(f\"{npz_path}: expected an (H, W, {len(BAND_ORDER)}) 'image' array, got {img.shape}\")\n","    return img\n","\n","\n","def load_rgb(npz_path):\n","    \"\"\"Raw RGB (first 3 bands, clipped to 0-255). Now used ONLY to draw pictures; the model never sees this.\"\"\"\n","    data = np.load(npz_path)\n","    image = data[\"image\"][:, :, :3].astype(np.float32)\n","    image = np.nan_to_num(image, nan=0.0, posinf=255.0, neginf=0.0)\n","    image = np.clip(image, 0.0, 255.0)\n","    return image\n","\n","\n","def scale_to_255(values, lo, hi):\n","    \"\"\"Robust per-band stretch to 0-255. NaN/-inf -> low end (0), +inf -> high end (255), like the RGB baseline.\"\"\"\n","    values = np.asarray(values, dtype=np.float32)\n","    values = np.nan_to_num(values, nan=lo, posinf=hi, neginf=lo)\n","    return (np.clip((values - lo) / (hi - lo), 0.0, 1.0) * 255.0).astype(np.float32)\n","\n","\n","def load_bands(npz_path, bands, band_stats):\n","    \"\"\"Select `bands` (in the given order) from the 8-band chip and scale each band with its own train-set range.\"\"\"\n","    img = read_npz_image(npz_path)\n","    out = np.empty((img.shape[0], img.shape[1], len(bands)), dtype=np.float32)\n","    for k, name in enumerate(bands):\n","        st = band_stats[name]\n","        out[:, :, k] = scale_to_255(img[:, :, BAND_INDEX[name]], st[\"lo\"], st[\"hi\"])\n","    return out\n","\n","\n","def compute_band_stats(npz_paths, pixels_per_image=5000, p_lo=1.0, p_hi=99.0, seed=0):\n","    \"\"\"Per-band robust range (1st-99th percentile) from a random pixel sample of the TRAIN chips only.\"\"\"\n","    rng = np.random.RandomState(seed)\n","    samples = [[] for _ in BAND_ORDER]\n","    for path in npz_paths:\n","        img = read_npz_image(path)\n","        flat = img.reshape(-1, img.shape[2])\n","        idx = rng.choice(flat.shape[0], size=min(pixels_per_image, flat.shape[0]), replace=False)\n","        chunk = flat[idx].astype(np.float32)\n","        for b in range(len(BAND_ORDER)):\n","            samples[b].append(chunk[:, b])\n","    stats = {}\n","    for b, name in enumerate(BAND_ORDER):\n","        v = np.concatenate(samples[b])\n","        v = np.where(np.isfinite(v), v, np.nan)\n","        if np.isnan(v).all():\n","            raise RuntimeError(f\"Band '{name}' has no finite pixels in the sampled training chips.\")\n","        lo, hi = np.nanpercentile(v, [p_lo, p_hi])\n","        if hi - lo < 1e-6:            # constant band -> avoid division by zero\n","            hi = lo + 1.0\n","        scaled = scale_to_255(v, lo, hi)\n","        stats[name] = {\"lo\": float(lo), \"hi\": float(hi), \"mean\": float(scaled.mean()),\n","                       \"raw_min\": float(np.nanmin(v)), \"raw_max\": float(np.nanmax(v)),\n","                       \"nan_pct\": float(np.isnan(v).mean() * 100)}\n","    return stats\n","\n","\n","BAND_STATS = None   # filled in NEW CELL 9A (needs the train split from Cell 9)"]},{"cell_type":"code","execution_count":7,"id":"92dc12fa